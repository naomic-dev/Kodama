# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
# Kodama reads these from ~/.config/kodama, outside the checkout. The patterns
# stay as a safety net so a stray local copy is never committed.
.env
.env.*
!.env.example

# Google API credentials and tokens
google_credentials.json
calendar_credentials.json
token.json
*.credentials.json

# Runtime state
data/
runtime/
*.log

# Local configuration
config.json

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
