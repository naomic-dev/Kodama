{
  "root": true,
  "env": {
    "node": true,
    "es2019": true
  },
  "parserOptions": {
    "ecmaVersion": 2019,
    "sourceType": "script"
  },
  "extends": [
    "eslint:recommended"
  ],
  "ignorePatterns": [
    "node_modules/",
    "data/",
    "runtime/"
  ],
  "rules": {
    "brace-style": ["error", "stroustrup"],
    "eqeqeq": ["error", "smart"],
    "indent": ["error", "tab", { "SwitchCase": 1 }],
    "no-var": "error",
    "prefer-const": "error",
    "quotes": ["error", "single", { "avoidEscape": true }],
    "semi": ["error", "always"]
  }
}
