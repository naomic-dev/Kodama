// OpenCode project configuration for Kodama.
// Docs: https://opencode.ai/docs/config
{
  "$schema": "https://opencode.ai/config.json",
  "policies": [
    // --- Credentials must not reach the model context --------------------
    //
    // Kodama reads config.json, .env, and the Google credential files from
    // ~/.config/kodama (see lib/paths.js), outside this repository. These
    // statements block the read and edit tools from touching that directory
    // and from touching stale copies left in the checkout.
    //
    // They gate tool permission checks only. Shell commands are a separate
    // action, so a shell command can still read these files; add `tool.use`
    // `shell:` statements if that matters, but those patterns are best-effort.
    { "action": "tool.use", "resource": "read:$HOME/.config/kodama/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:$HOME/.config/kodama/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:.env", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:.env", "effect": "deny" },
    { "action": "tool.use", "resource": "read:config.json", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:config.json", "effect": "deny" },
    { "action": "tool.use", "resource": "read:google_credentials.json", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:google_credentials.json", "effect": "deny" },
    { "action": "tool.use", "resource": "read:token.json", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:token.json", "effect": "deny" }
  ]
}
