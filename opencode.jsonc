// OpenCode project configuration for Kodama.
// Docs: https://opencode.ai/docs/config
{
  "$schema": "https://opencode.ai/config.json",
  "policies": [
    // --- Credentials must not reach the model context --------------------
    //
    // These block the file tools only. Configuration still reads secrets via
    // {file:...}, which the config loader resolves before any tool runs, so
    // MCP tokens and provider keys keep working.
    { "action": "tool.use", "resource": "read:*.config.json", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.google_credentials.json", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.token.json", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.config.json", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.google_credentials.json", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.token.json", "effect": "deny" }
  ]
}
