# Copy this file to ~/.config/kodama/.env, or to $KODAMA_HOME/.env.
#
# Kodama reads its environment, config.json, and Google credentials from that
# directory, never from the repository checkout. Set KODAMA_HOME to keep the
# whole set somewhere else.

# Discord bot token from https://discord.com/developers/applications
BOT_TOKEN=your-bot-token-here

# Where runtime JSON state is stored (defaults to ~/.local/share/kodama)
DATA_DIR=~/.local/share/kodama

# Optional: point one file somewhere other than KODAMA_HOME
# CONFIG_PATH=~/.config/kodama/config.json
# GOOGLE_CREDENTIALS_PATH=~/.config/kodama/google_credentials.json
# GOOGLE_TOKEN_PATH=~/.config/kodama/token.json

# Minimum log level: error, warn, info, or debug (defaults to info)
LOG_LEVEL=info

# Log output: text for people, json for log collection (defaults to text)
LOG_FORMAT=text
