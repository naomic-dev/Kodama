# Discord bot token from https://discord.com/developers/applications
BOT_TOKEN=your-bot-token-here

# Set to "true" to read and write state from <DATA_DIR>/dev
DEV=false

# Where runtime JSON state is stored (defaults to ./data)
DATA_DIR=./data

# Minimum log level: error, warn, info, or debug (defaults to info)
LOG_LEVEL=info

# Log output: text for people, json for log collection (defaults to text)
LOG_FORMAT=text
